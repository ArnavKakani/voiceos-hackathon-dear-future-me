{
  "crons": [
    {
      "path": "/api/cron/seed-accomplishments",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/v1/cron/deliver-letters",
      "schedule": "0 14 * * *"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
